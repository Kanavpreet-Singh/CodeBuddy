# Base URL of the FastAPI agent service (Milestone 1).
# Default uvicorn port is 8000; override if that port is taken locally.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Postgres connection string (Prisma reads this from web/.env).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Google OAuth credentials (Google Cloud Console > Credentials > OAuth client).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret

# NextAuth session secret. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=your-generated-secret
